# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/eleniyan
DIRECT_URL=postgresql://postgres:password@localhost:5432/eleniyan

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-random-64-char-secret-here

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ─── AWS S3 / CloudFront ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-bucket-name
AWS_CLOUDFRONT_URL=https://xxxxxxxxxx.cloudfront.net

# ─── WhatsApp Business API (Meta) ─────────────────────────────────────────────
WHATSAPP_TOKEN=your-whatsapp-business-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_SALES_NUMBER=234XXXXXXXXXX
WHATSAPP_TEMPLATE_NAME=new_lead_notification

# ─── HubSpot CRM ──────────────────────────────────────────────────────────────
HUBSPOT_API_KEY=your-hubspot-private-app-token

# ─── Brevo Email ──────────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_NEWSLETTER_LIST_ID=1
FROM_EMAIL=your-email@gmail.com
BUSINESS_EMAIL=your-email@gmail.com

# ─── Paystack (add keys when ready) ───────────────────────────────────────────
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
PAYSTACK_PUBLIC_KEY=your-paystack-public-key-here
